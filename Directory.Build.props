<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.3.0</Version>
    <Authors>Compteur retraite</Authors>
    <!-- Dépôt GitHub public d'où viennent les mises à jour automatiques. Vide = mise à jour désactivée. -->
    <DepotGitHub>caminin/Retraite</DepotGitHub>
  </PropertyGroup>
</Project>
