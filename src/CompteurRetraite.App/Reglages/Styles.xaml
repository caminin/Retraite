<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette -->
    <SolidColorBrush x:Key="Fond" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Carte" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Encre" Color="#16202E" />
    <SolidColorBrush x:Key="Discret" Color="#5D6B7E" />
    <SolidColorBrush x:Key="Trait" Color="#DDE2EA" />
    <SolidColorBrush x:Key="Accent" Color="#0B6BCB" />
    <SolidColorBrush x:Key="AccentClair" Color="#E3F0FC" />

    <SolidColorBrush x:Key="JourTravaille" Color="#FFFFFF" />
    <SolidColorBrush x:Key="JourNonTravaille" Color="#BFDDFB" />
    <SolidColorBrush x:Key="JourNonTravailleEncre" Color="#0B4F9C" />
    <SolidColorBrush x:Key="JourFerie" Color="#FFE1C2" />
    <SolidColorBrush x:Key="JourFerieEncre" Color="#8A4A12" />
    <SolidColorBrush x:Key="JourWeekEnd" Color="#ECEEF2" />
    <SolidColorBrush x:Key="JourWeekEndEncre" Color="#9AA3AF" />

    <Style x:Key="Titre" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="Etiquette" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Discret}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CarteStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
    </Style>

    <!-- Bouton arrondi -->
    <Style x:Key="Bouton" TargetType="Button">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cadre" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource Bouton}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="Lien" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Discret}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choix sous forme de pastilles -->
    <Style x:Key="Pastille" TargetType="RadioButton">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Cadre" Background="{StaticResource Carte}" BorderBrush="{StaticResource Trait}"
                            BorderThickness="1" CornerRadius="18" Padding="14,7">
                        <ContentPresenter x:Name="Texte" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cadre" Property="Background" Value="{StaticResource AccentClair}" />
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Cadre" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
