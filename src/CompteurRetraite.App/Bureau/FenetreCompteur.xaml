<Window x:Class="CompteurRetraite.App.Bureau.FenetreCompteur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compteur retraite"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        IsHitTestVisible="False" Left="-10000" Top="-10000">
    <StackPanel x:Name="Pile" Margin="12">
        <StackPanel.Effect>
            <DropShadowEffect x:Name="Ombre" BlurRadius="12" ShadowDepth="1" Opacity="0.35" Color="Black" />
        </StackPanel.Effect>
        <TextBlock x:Name="TexteMessage" TextWrapping="Wrap" FontWeight="SemiBold"
                   FontFamily="Segoe UI Variable Display, Segoe UI" />
        <TextBlock x:Name="TexteChiffre" FontWeight="Bold" LineStackingStrategy="BlockLineHeight"
                   FontFamily="Segoe UI Variable Display, Segoe UI" />
        <TextBlock x:Name="TexteLibelle" FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,2,0,0" />
        <StackPanel x:Name="ZoneProgression" Orientation="Horizontal" Margin="0,10,0,0">
            <Grid x:Name="Barre" Height="4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColFait" Width="0*" />
                    <ColumnDefinition x:Name="ColReste" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Piste" Grid.ColumnSpan="2" CornerRadius="2" />
                <Border x:Name="Remplissage" Grid.Column="0" CornerRadius="2" />
            </Grid>
            <TextBlock x:Name="TextePourcentage" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI" />
        </StackPanel>
    </StackPanel>
</Window>
