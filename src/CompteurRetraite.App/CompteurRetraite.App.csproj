<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CompteurRetraite</AssemblyName>
    <RootNamespace>CompteurRetraite.App</RootNamespace>
    <Product>Compteur retraite</Product>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DepotGitHub" Value="$(DepotGitHub)" />
    <!-- WPF et WinForms ensemble : on évite les usings implicites WinForms qui créent des ambiguïtés. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CompteurRetraite.Core\CompteurRetraite.Core.csproj" />
  </ItemGroup>
</Project>
